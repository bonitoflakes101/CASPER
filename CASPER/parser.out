Parsing method: LALR

state 0

    (0) S' -> . program
    (1) program -> . BIRTH LBRACE global_dec function_statements main_function RBRACE GHOST

    BIRTH           shift and go to state 2

    program                        shift and go to state 1

state 1

    (0) S' -> program .



state 2

    (1) program -> BIRTH . LBRACE global_dec function_statements main_function RBRACE GHOST

    LBRACE          shift and go to state 3


state 3

    (1) program -> BIRTH LBRACE . global_dec function_statements main_function RBRACE GHOST
    (3) global_dec -> . global_statement SEMICOLON global_tail
    (4) global_dec -> . empty
    (6) global_statement -> . var_statement global_statement_tail
    (629) empty -> .
    (7) var_statement -> . data_type IDENT list_dec
    (25) data_type -> . INT
    (26) data_type -> . FLT
    (27) data_type -> . BLN
    (28) data_type -> . STR

    FUNCTION        reduce using rule 629 (empty -> .)
    FUNCTION_INT    reduce using rule 629 (empty -> .)
    FUNCTION_FLT    reduce using rule 629 (empty -> .)
    FUNCTION_BLN    reduce using rule 629 (empty -> .)
    FUNCTION_STR    reduce using rule 629 (empty -> .)
    FUNCTION_LIST_INT reduce using rule 629 (empty -> .)
    FUNCTION_LIST_FLT reduce using rule 629 (empty -> .)
    FUNCTION_LIST_STR reduce using rule 629 (empty -> .)
    FUNCTION_LIST_BLN reduce using rule 629 (empty -> .)
    MAIN_CASPER     reduce using rule 629 (empty -> .)
    INT             shift and go to state 9
    FLT             shift and go to state 10
    BLN             shift and go to state 11
    STR             shift and go to state 12

    global_dec                     shift and go to state 4
    global_statement               shift and go to state 5
    empty                          shift and go to state 6
    var_statement                  shift and go to state 7
    data_type                      shift and go to state 8

state 4

    (1) program -> BIRTH LBRACE global_dec . function_statements main_function RBRACE GHOST
    (96) function_statements -> . ret_type FUNCTION_NAME LPAREN parameters RPAREN LBRACE statements RBRACE function_statements_tail
    (97) function_statements -> . empty
    (100) ret_type -> . FUNCTION
    (101) ret_type -> . function_dtype
    (629) empty -> .
    (102) function_dtype -> . FUNCTION_INT
    (103) function_dtype -> . FUNCTION_FLT
    (104) function_dtype -> . FUNCTION_BLN
    (105) function_dtype -> . FUNCTION_STR
    (106) function_dtype -> . FUNCTION_LIST_INT
    (107) function_dtype -> . FUNCTION_LIST_FLT
    (108) function_dtype -> . FUNCTION_LIST_STR
    (109) function_dtype -> . FUNCTION_LIST_BLN

    FUNCTION        shift and go to state 16
    MAIN_CASPER     reduce using rule 629 (empty -> .)
    FUNCTION_INT    shift and go to state 18
    FUNCTION_FLT    shift and go to state 19
    FUNCTION_BLN    shift and go to state 20
    FUNCTION_STR    shift and go to state 21
    FUNCTION_LIST_INT shift and go to state 22
    FUNCTION_LIST_FLT shift and go to state 23
    FUNCTION_LIST_STR shift and go to state 24
    FUNCTION_LIST_BLN shift and go to state 25

    function_statements            shift and go to state 13
    ret_type                       shift and go to state 14
    empty                          shift and go to state 15
    function_dtype                 shift and go to state 17

state 5

    (3) global_dec -> global_statement . SEMICOLON global_tail

    SEMICOLON       shift and go to state 26


state 6

    (4) global_dec -> empty .

    FUNCTION        reduce using rule 4 (global_dec -> empty .)
    FUNCTION_INT    reduce using rule 4 (global_dec -> empty .)
    FUNCTION_FLT    reduce using rule 4 (global_dec -> empty .)
    FUNCTION_BLN    reduce using rule 4 (global_dec -> empty .)
    FUNCTION_STR    reduce using rule 4 (global_dec -> empty .)
    FUNCTION_LIST_INT reduce using rule 4 (global_dec -> empty .)
    FUNCTION_LIST_FLT reduce using rule 4 (global_dec -> empty .)
